// use prisma-8

enum AppRole {
  @@type("pg/text@1")
  ADMIN = "admin"
}

enum InquiryStatus {
  @@type("pg/text@1")
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum JobStatus {
  @@type("pg/text@1")
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  @@type("pg/text@1")
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
}

model UserRole {
  id        Uuid             @id @default(uuid())
  userId    Uuid
  role      AppRole
  createdAt TimestamptzString @default(now())

  @@unique([userId, role])
  @@map("user_roles")
}

model ContactInquiry {
  id               Uuid             @id @default(uuid())
  organizationName String
  fullName         String?
  email            String?
  countryCode      String?
  phone            String?
  country          String?
  state            String?
  city             String?
  goal             String?
  service          String?
  description      String?
  status           InquiryStatus    @default(NEW)
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())

  @@index([status, createdAt])
  @@map("contact_inquiries")
}

model Category {
  id        Uuid              @id @default(uuid())
  name      String            @unique
  slug      String            @unique
  createdAt TimestamptzString @default(now())
  insights  Insight[]

  @@map("categories")
}

model Insight {
  id             Uuid              @id @default(uuid())
  title          String
  slug           String            @unique
  excerpt        String            @default("")
  content        String            @default("")
  coverImage     String?
  author         String            @default("Ad Growth Partner")
  categoryId     Uuid?
  readingTime    Int               @default(4)
  seoTitle       String?
  seoDescription String?
  published      Boolean           @default(false)
  publishedAt    TimestamptzString?
  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())

  category Category? @relation(
    fields: [categoryId],
    references: [id],
    onDelete: SetNull
  )

  @@index([published, publishedAt])
  @@map("insights")
}

model CaseStudy {
  id         Uuid              @id @default(uuid())
  title      String
  slug       String            @unique
  client     String            @default("")
  industry   String            @default("")
  summary    String            @default("")
  challenge  String            @default("")
  approach   String            @default("")
  execution  String            @default("")
  results    String            @default("")
  services   String[]          @default([])
  coverImage String?
  gallery    String[]          @default([])
  year       Int?
  published  Boolean           @default(false)
  sortOrder  Int               @default(0)
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@index([published, sortOrder])
  @@map("case_studies")
}

model Job {
  id             Uuid              @id @default(uuid())
  title          String
  slug           String            @unique
  location       String            @default("")
  employmentType String            @default("Full-time")
  team           String            @default("")
  description    String            @default("")
  requirements   String            @default("")
  status         JobStatus         @default(DRAFT)
  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString @default(now())
  applications   JobApplication[]

  @@index([status, createdAt])
  @@map("jobs")
}

model JobApplication {
  id           Uuid              @id @default(uuid())
  jobId        Uuid?
  jobTitle     String            @default("")
  fullName     String
  email        String
  countryCode  String            @default("+91")
  phone        String
  resumeUrl    String
  portfolioUrl String?
  message      String            @default("")
  status       ApplicationStatus @default(NEW)
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())

  job Job? @relation(
    fields: [jobId],
    references: [id],
    onDelete: SetNull
  )

  @@index([jobId, createdAt])
  @@map("job_applications")
}

model AdminUser {
  id           Uuid              @id @default(uuid())
  email        String            @unique
  passwordHash String
  createdAt    TimestamptzString @default(now())
  updatedAt    TimestamptzString @default(now())

  @@map("admin_users")
}